rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------- helpers ---------------- */

    function isAuthed() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthed()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    function isApprovedCreator() {
      return isAuthed()
        && get(/databases/$(database)/documents/creators/$(request.auth.uid)).data.verified == true
        && get(/databases/$(database)/documents/creators/$(request.auth.uid)).data.addedToCollancer == true
        && get(/databases/$(database)/documents/creators/$(request.auth.uid)).data.banned == false;
    }

    function docVal(data, key, dflt) {
      return key in data ? data[key] : dflt;
    }

    /* ---------------- admins ---------------- */

    match /admins/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false; // client cannot write admin docs
    }

    /* ---------------- creators ---------------- */

    match /creators/{id} {
      allow read: if true; // public discovery

      allow create: if isOwner(id)
        && (!('verified' in request.resource.data) || request.resource.data.verified == false)
        && (!('addedToCollancer' in request.resource.data) || request.resource.data.addedToCollancer == false)
        && (!('banned' in request.resource.data) || request.resource.data.banned == false)
        && !('verificationStatus' in request.resource.data)
        && !('adminNotes' in request.resource.data);

      allow update: if isAdmin()
        || (isOwner(id)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['verificationStatus', 'verified', 'addedToCollancer', 'adminNotes', 'banned', 'instagram', 'rating'])
          && (resource.data.get('instagram', null) == null
            || !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['handle', 'handleLower', 'pfp', 'followers', 'bio'])));
        // B-M9 (rating manipulation): the old branch let ANY signed-in user
        // rewrite any creator's rating 0-5. Rules cannot verify a completed-
        // booking rater<->creator relationship without a query, so client
        // rating writes are now admin/server-only. The safe client path is a
        // future ratings-by-bookingId flow (ratings/{bookingId}, booking
        // Completed && booking.bizId == auth.uid).

      allow delete: if false;
    }

    /* ---------------- instagram_tokens (server-only via Admin SDK) ----------------
       Long-lived Instagram tokens. Never readable/writable by clients —
       the OAuth callback + refresh endpoints use the Admin SDK (bypasses rules). */

    match /instagram_tokens/{uid} {
      allow read, write: if false;
    }

    /* ---------------- instagram_oauth_states (server-only CSRF states) ---------------- */

    match /instagram_oauth_states/{state} {
      allow read, write: if false;
    }

    /* ---------------- instagram_debug (server-only OAuth diagnostics) ---------------- */

    match /instagram_debug/{state} {
      allow read, write: if false;
    }

    /* ---------------- creatorHandles ---------------- */

    match /creatorHandles/{handleLower} {
      allow read: if true;
      allow create: if isAuthed()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.handleLower == handleLower;
      allow update, delete: if isAdmin();
    }

    /* ---------------- public creator media kits ---------------- */
    match /mediaKits/{creatorId} {
      allow read: if resource.data.isPublic == true;
      allow create: if isAuthed()
        && request.auth.uid == creatorId
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.isPublic == true;
      allow update: if isAuthed()
        && request.auth.uid == creatorId
        && request.resource.data.creatorId == request.auth.uid;
      allow delete: if isAuthed() && request.auth.uid == creatorId;
    }

    /* ---------------- scam alerts community feed ---------------- */

    match /scamAlerts/{id} {
      allow read: if true;
      // Any signed-in Collancer creator may submit a community warning.
      // Reports remain explicitly unverified in the UI and are admin-moderated.
      allow create: if isAuthed()
        && exists(/databases/$(database)/documents/creators/$(request.auth.uid))
        && docVal(get(/databases/$(database)/documents/creators/$(request.auth.uid)).data, 'banned', false) == false
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.creatorName is string
        && request.resource.data.creatorName.size() <= 120
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 140
        && request.resource.data.type in ['brand', 'agency', 'campaign', 'individual', 'payment']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 600
        && (!('evidence' in request.resource.data)
          || (request.resource.data.evidence is list
            && request.resource.data.evidence.size() <= 4));
      allow update, delete: if isAdmin();
    }

    /* ---------------- businesses ---------------- */

    function refundBookingData(bid) {
      return get(/databases/$(database)/documents/bookings/$(bid)).data;
    }

    function refundBookingValid(uid, inc) {
      let bid = docVal(request.resource.data, 'refundBookingId', null);
      return bid != null
        && refundBookingData(bid).bizId == uid
        && refundBookingData(bid).status == 'Cancelled'
        && refundBookingData(bid).paymentMethod == 'wallet'
        && docVal(refundBookingData(bid), 'refundProcessed', false) == false
        && refundBookingData(bid).escrowAmount == inc;
    }

    match /businesses/{uid} {
      // Brands can access only their own profile. Financial entitlements and balances
      // are server/admin-managed and cannot be changed by a client.
      allow get: if isAdmin() || isOwner(uid);
      allow list: if isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'bizName', 'email', 'phone', 'pfp', 'industry', 'address',
          'walletBalance', 'isPro', 'proActive', 'createdAt'
        ])
        && request.resource.data.bizName is string
        && request.resource.data.bizName.size() >= 2
        && request.resource.data.bizName.size() <= 120
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.phone is string
        && request.resource.data.pfp is string
        && request.resource.data.industry is string
        && request.resource.data.address is string
        && request.resource.data.walletBalance == 0
        && request.resource.data.isPro == false
        && request.resource.data.proActive == false
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin()
        || (isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'bizName', 'email', 'phone', 'pfp', 'industry', 'address'
          ])
          && request.resource.data.bizName is string
          && request.resource.data.bizName.size() >= 2
          && request.resource.data.bizName.size() <= 120
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.phone is string
          && request.resource.data.pfp is string
          && request.resource.data.industry is string
          && request.resource.data.address is string);

      allow delete: if isAdmin();
    }

    /* ---------------- bookings ---------------- */

    // C7#7: money fields are server-managed — /api/booking-create writes them
    // via the admin SDK (bypassing rules). On client create they must be
    // absent or equal to moneyless safe defaults (barter-style bookings carry
    // paidAmount 0 + 'not_required' statuses). This closes the fake
    // wallet-credit / paidAmount-forgery path at the rules layer.
    function bookingCreateMoneySafe(d) {
      return (!('paidAmount' in d) || d.paidAmount == 0)
        && (!('paymentStatus' in d) || d.paymentStatus == 'not_required')
        && (!('escrowStatus' in d) || d.escrowStatus == 'not_required')
        && (!('paymentReference' in d) || d.paymentReference == null)
        && (!('refundAmount' in d) || d.refundAmount == 0);
    }

    match /bookings/{id} {
      allow read: if isAdmin()
        || (isAuthed() && (
          resource.data.bizId == request.auth.uid
          || resource.data.creatorId == request.auth.uid));

      allow create: if isAuthed()
        && request.resource.data.bizId == request.auth.uid
        && request.resource.data.creatorId is string
        && request.resource.data.creatorId.size() > 0
        && request.resource.data.status == 'Pending'
        && docVal(request.resource.data, 'paymentApproved', false) == false
        && !('releasedAt' in request.resource.data)
        && !('releasedBy' in request.resource.data)
        && !('adminRevenueId' in request.resource.data)
        && bookingCreateMoneySafe(request.resource.data);

      allow update: if isAdmin()
        // CREATOR/brand mark-as-seen + chat read timestamps (no status change)
        || (isAuthed() && resource.data.creatorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenByCreator', 'creatorChatReadAt']))
        || (isAuthed() && resource.data.bizId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenByBiz', 'brandChatReadAt']))
        // either party may stamp last-message metadata when chatting
        || (isAuthed()
          && (resource.data.creatorId == request.auth.uid || resource.data.bizId == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt', 'lastMessageFrom']))
        // CREATOR accept: Pending -> Active
        || (isAuthed() && resource.data.creatorId == request.auth.uid
          && resource.data.status == 'Pending'
          && request.resource.data.status == 'Active'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'acceptedAt', 'acceptedByCreator', 'seenByCreator',
              'creatorAddress', 'addressSharedAt', 'addressSharedTo']))
        // CREATOR reject: Pending -> Cancelled
        // C6#3: refundAmount can never exceed what the brand actually paid
        // (refundAmount <= existing paidAmount) — fails closed when
        // paidAmount is not a number. Closes the collusion money-printing
        // loop at the rules layer too (the cron additionally uses only
        // server-truth paidAmount).
        || (isAuthed() && resource.data.creatorId == request.auth.uid
          && resource.data.status == 'Pending'
          && request.resource.data.status == 'Cancelled'
          && (!('refundAmount' in request.resource.data)
            || (request.resource.data.refundAmount is number
              && request.resource.data.refundAmount >= 0
              && request.resource.data.refundAmount <=
                (resource.data.paidAmount is number ? resource.data.paidAmount : 0)))
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'rejectedAt', 'rejectedByCreator', 'rejectionReason',
              'refundProcessed', 'refundAmount', 'refundStatus', 'refundedAt', 'seenByCreator']))
        // CREATOR delivery submit: Active -> PendingCompletion
        || (isAuthed() && resource.data.creatorId == request.auth.uid
          && resource.data.status == 'Active'
          && request.resource.data.status == 'PendingCompletion'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'driveLink', 'promotedVideoLink', 'deliverySubmittedAt',
              'completionRequestedAt', 'adminRejected', 'adminRejectionReason',
              'reviewDeadline', 'seenByCreator']))
        // BUSINESS cancel: Pending/Active -> Cancelled
        || (isAuthed() && resource.data.bizId == request.auth.uid
          && resource.data.status in ['Pending', 'Active']
          && request.resource.data.status == 'Cancelled'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'cancelledAt', 'cancelledByBiz', 'cancelReason', 'seenByBiz']))
        // BUSINESS approve: PendingCompletion -> Completed
        || (isAuthed() && resource.data.bizId == request.auth.uid
          && resource.data.status == 'PendingCompletion'
          && request.resource.data.status == 'Completed'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'approvedAt', 'approvedByBiz', 'payoutStatus', 'updatedAt', 'seenByBiz']))
        // BUSINESS revision: PendingCompletion -> Active
        || (isAuthed() && resource.data.bizId == request.auth.uid
          && resource.data.status == 'PendingCompletion'
          && request.resource.data.status == 'Active'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'revisionRequested', 'revisionNote', 'revisionCount',
              'revisionRequestedAt', 'reviewDeadline', 'updatedAt', 'seenByBiz']))
        // BUSINESS dispute: PendingCompletion -> Disputed
        || (isAuthed() && resource.data.bizId == request.auth.uid
          && resource.data.status == 'PendingCompletion'
          && request.resource.data.status == 'Disputed'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'disputeReason', 'disputeOpenedAt', 'disputeOpenedBy',
              'updatedAt', 'seenByBiz']));

      allow delete: if false;
    }

    /* ---------------- wallet ---------------- */

    match /walletDeposits/{id} {
      allow read: if isAdmin() || (isAuthed() && resource.data.bizId == request.auth.uid);
      allow create: if isAuthed()
        && request.resource.data.bizId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount >= 100;
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /walletTransactions/{id} {
      allow read: if isAdmin() || (isAuthed() && resource.data.bizId == request.auth.uid);
      // B-M7: entries are bound to the writer's own business — no forging
      // ledger rows for other businesses. Append-only (update/delete denied).
      allow create: if isAuthed()
        && request.resource.data.bizId == request.auth.uid
        && request.resource.data.type in ['deposit', 'booking_deduction', 'refund'];
      allow update, delete: if false; // append-only ledger
    }

    /* ---------------- payouts ---------------- */

    // Canonical creator earnings for a payout booking (95% of creatorPrice).
    // Fails closed: missing booking doc or missing creatorPrice denies.
    function payoutBookingData() {
      return get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data;
    }

    match /payoutRequests/{id} {
      allow read: if isAdmin() || (isAuthed() && resource.data.creatorId == request.auth.uid);
      // B-H4: payout amount must EXACTLY equal the booking's canonical
      // creator earnings — Math.round(creatorPrice * 0.95). bookingId is
      // required in both branches so no invented amounts pass. One payout
      // per booking: the doc id is bound to the booking so duplicate
      // (double-submit / duped client) payout requests are denied.
      allow create: if isAuthed()
        && request.resource.data.status == 'pending'
        && request.resource.data.amount >= 100
        && request.resource.data.bookingId is string
        && request.resource.id == 'payout_' + request.resource.data.bookingId
        && request.resource.data.amount == Math.round(payoutBookingData().creatorPrice * 0.95)
        && (request.resource.data.creatorId == request.auth.uid
          // brand may queue payout for its completed booking
          || (payoutBookingData().bizId == request.auth.uid
            && payoutBookingData().status == 'Completed'));
      allow update: if isAdmin();
      allow delete: if false;
    }

    /* ---------------- verification ---------------- */

    match /verificationRequests/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.creatorId == uid
        && request.resource.data.status == 'pending';
      // creator may update own pending request / resubmit after rejection
      allow update: if isAdmin()
        || (isOwner(uid)
          && resource.data.status in ['pending', 'rejected']
          && request.resource.data.status == 'pending');
      allow delete: if false;
    }

    /* ---------------- requirements marketplace ---------------- */

    match /requirements/{id} {
      allow read: if true;

      allow create: if isAuthed()
        && request.resource.data.bizId == request.auth.uid
        && request.resource.data.status == 'open';

      allow update: if isAdmin()
        // business manages own requirement
        || (isAuthed() && resource.data.bizId == request.auth.uid)
        // narrow creator reopen: matched -> open (accepted offer's booking was rejected)
        || (isAuthed()
          && resource.data.status == 'matched'
          && request.resource.data.status == 'open'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'acceptedOfferId', 'matchedAt', 'updatedAt']))
        // creator proposal submission updates only the visible proposal counter by one
        || (isAuthed()
          && exists(/databases/$(database)/documents/creators/$(request.auth.uid))
          && resource.data.status in ['open', 'matched']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offerCount'])
          && docVal(request.resource.data, 'offerCount', 0) == docVal(resource.data, 'offerCount', 0) + 1);

      allow delete: if isAuthed() && resource.data.bizId == request.auth.uid;
    }

    match /requirementOffers/{id} {
      allow read: if isAuthed() && (
        resource.data.creatorId == request.auth.uid
        || resource.data.bizId == request.auth.uid
        || isAdmin());

      allow create: if isAuthed()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if isAdmin()
        // creator withdraws own pending offer
        || (isAuthed() && resource.data.creatorId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'withdrawn'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'withdrawnAt', 'updatedAt']))
        // business owning the requirement accepts/rejects
        || (isAuthed() && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted', 'rejected']
          && get(/databases/$(database)/documents/requirements/$(resource.data.requirementId)).data.bizId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt']))
        // creator releases an accepted offer back to pending (booking was rejected)
        || (isAuthed() && resource.data.creatorId == request.auth.uid
          && resource.data.status == 'accepted'
          && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt']));

      allow delete: if false;
    }

    /* ---------------- reviews ---------------- */

    match /reviews/{id} {
      allow read: if true;
      allow create: if isAuthed()
        && request.resource.data.creatorId is string
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5;
      allow update, delete: if false;
    }

    /* ---------------- booking messages (in-booking chat) ---------------- */

    match /booking_messages/{id} {
      allow read: if isAdmin() || (isAuthed() && (
        get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.bizId == request.auth.uid ||
        get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.creatorId == request.auth.uid));
      allow create: if isAuthed()
        && request.resource.data.bookingId is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && (request.resource.data.senderType == 'brand' || request.resource.data.senderType == 'creator')
        // sender must be the brand or creator of this booking
        && ((request.resource.data.senderType == 'brand'
            && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.bizId == request.auth.uid)
          || (request.resource.data.senderType == 'creator'
            && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.creatorId == request.auth.uid));
      allow update, delete: if false;
    }

    /* ---------------- promo demos ---------------- */

    match /promoDemos/{id} {
      allow read: if true;
      allow create: if isAuthed() && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (isAuthed() && resource.data.creatorId == request.auth.uid);
    }

    /* ---------------- Be On Top campaigns ---------------- */

    match /adCampaigns/{id} {
      allow read: if true; // discovery reads active boosts
      allow create: if isAuthed()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.status == 'active';
      allow update: if isAdmin() || (isAuthed() && resource.data.creatorId == request.auth.uid);
      allow delete: if false;
    }

    /* ---------------- business campaigns (display metadata) ---------------- */

    match /bizCampaigns/{id} {
      allow read: if isAdmin() || (isAuthed() && resource.data.bizId == request.auth.uid);
      allow create, update: if isAuthed() && request.resource.data.bizId == request.auth.uid;
      allow delete: if isAdmin();
    }

    /* ---------------- pro payments ---------------- */

    match /proPayments/{id} {
      allow read: if isAdmin() || (isAuthed() && resource.data.bizId == request.auth.uid);
      allow create: if isAuthed() && request.resource.data.bizId == request.auth.uid;
      allow update, delete: if false;
    }

    match /creatorProPayments/{id} {
      allow read: if isAdmin() || (isAuthed() && resource.data.creatorId == request.auth.uid);
      allow create: if isAuthed() && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if false;
    }

    /* ---------------- notifications ---------------- */

    match /bizNotifs/{id} {
      allow read: if isAdmin() || (isAuthed() && resource.data.bizId == request.auth.uid);
      // B-M8 anti-phishing: only the owning business (or admin/server) may
      // create its own notifications — no cross-user forged alerts.
      allow create: if isAuthed() && (request.resource.data.bizId == request.auth.uid || isAdmin());
      allow update: if isAdmin()
        || (isAuthed() && resource.data.bizId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']));
      allow delete: if false;
    }

    match /creatorNotifs/{id} {
      allow read: if isAdmin() || (isAuthed() && resource.data.creatorId == request.auth.uid);
      // B-M8 anti-phishing: only the owning creator (or admin/server) may
      // create its own notifications — no cross-user forged alerts.
      allow create: if isAuthed() && (request.resource.data.creatorId == request.auth.uid || isAdmin());
      allow update: if isAdmin()
        || (isAuthed() && resource.data.creatorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']));
      allow delete: if false;
    }

    match /adminNotifs/{id} {
      allow read, update: if isAdmin();
      // B-M8: admin alerts come from admin/server only — clients cannot
      // inject fake admin notifications.
      allow create: if isAdmin();
      allow delete: if false;
    }

    /* ---------------- admin revenue ledger ---------------- */

    match /adminRevenue/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        // creator-created ad_revenue entries (Be On Top)
        || (isAuthed()
          && request.resource.data.type == 'ad_revenue'
          && request.resource.data.creatorId == request.auth.uid);
      allow update, delete: if false;
    }

    /* ---------------- pre-registrations (CollancerWeb + Registerationadmin) ---------------- */
    // CollancerWeb is a public site with no auth: it runs a dup-check query
    // (where email == X, limit 1) and creates docs — read + create stay
    // public. update/delete were public (B-H3: anyone could rewrite or wipe
    // PII registrations); they are now admin-only. Admin tooling must use
    // the Admin SDK (bypasses rules), not the unauthenticated client.
    match /registrations/{id} {
      allow read: if true;
      allow create: if request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.phone is string;
      allow update, delete: if isAdmin();
    }

    /* ---------------- default deny ---------------- */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
